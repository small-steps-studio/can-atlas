{
  "name": "DBC",
  "scopeName": "source.dbc",
  "patterns": [
    { "include": "#strings" },
    { "include": "#signal-spec" },
    { "include": "#statement-keywords" },
    { "include": "#attribute-types" },
    { "include": "#multiplexer" },
    { "include": "#no-node" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "strings": {
      "name": "string.quoted.double.dbc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.dbc", "match": "\\\\[\"\\\\]" }
      ]
    },
    "statement-keywords": {
      "patterns": [
        {
          "name": "keyword.control.statement.dbc",
          "match": "^\\s*\\b(VERSION|NS_|NS_DESC_|BS_|BU_|BO_|BO_TX_BU_|SG_|SG_MUL_VAL_|SIG_VALTYPE_|VAL_|VAL_TABLE_|CM_|BA_|BA_DEF_|BA_DEF_DEF_|BA_DEF_REL_|BA_DEF_DEF_REL_|BA_REL_|BA_DEF_SGTYPE_|BA_SGTYPE_|EV_|ENVVAR_DATA_|SGTYPE_|SGTYPE_VAL_|SIG_TYPE_REF_|SIG_GROUP_|CAT_DEF_|CAT_|FILTER|EV_DATA_|SIGTYPE_VALTYPE_|BU_SG_REL_|BU_EV_REL_|BU_BO_REL_)(?=[\\s:]|$)"
        },
        {
          "name": "storage.type.object.dbc",
          "match": "\\b(BU_|BO_|SG_|EV_)\\b"
        },
        {
          "name": "keyword.other.section.dbc",
          "match": "^\\s+(NS_DESC_|CM_|BA_DEF_|BA_|VAL_|CAT_DEF_|CAT_|FILTER|BA_DEF_DEF_|EV_DATA_|ENVVAR_DATA_|SGTYPE_|SGTYPE_VAL_|BA_DEF_SGTYPE_|BA_SGTYPE_|SIG_TYPE_REF_|VAL_TABLE_|SIG_GROUP_|SIG_VALTYPE_|SIGTYPE_VALTYPE_|BO_TX_BU_|BA_DEF_REL_|BA_REL_|BA_DEF_DEF_REL_|BU_SG_REL_|BU_EV_REL_|BU_BO_REL_|SG_MUL_VAL_)\\s*$"
        }
      ]
    },
    "signal-spec": {
      "patterns": [
        {
          "name": "meta.signal-layout.dbc",
          "match": "(\\d+)\\s*(\\|)\\s*(\\d+)\\s*(@)\\s*([01])([+-])",
          "captures": {
            "1": { "name": "constant.numeric.start-bit.dbc" },
            "2": { "name": "punctuation.separator.dbc" },
            "3": { "name": "constant.numeric.length.dbc" },
            "4": { "name": "punctuation.separator.dbc" },
            "5": { "name": "storage.modifier.byte-order.dbc" },
            "6": { "name": "storage.modifier.sign.dbc" }
          }
        }
      ]
    },
    "attribute-types": {
      "name": "storage.type.attribute.dbc",
      "match": "\\b(INT|HEX|FLOAT|STRING|ENUM)\\b"
    },
    "multiplexer": {
      "name": "keyword.operator.multiplexer.dbc",
      "match": "(?<=\\s)(M|m\\d+M?)(?=\\s*:)"
    },
    "no-node": {
      "name": "constant.language.no-node.dbc",
      "match": "\\bVector__XXX\\b"
    },
    "numbers": {
      "name": "constant.numeric.dbc",
      "match": "[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?"
    },
    "punctuation": {
      "name": "punctuation.separator.dbc",
      "match": "[:;,()\\[\\]|]"
    }
  }
}
