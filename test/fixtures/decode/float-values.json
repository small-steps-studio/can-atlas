[
  { "file": "09-float-signals.dbc", "id": 1792, "data": "00 50 7D 44 00 00 00 00",
    "how": "IEEE 754 single: 1013.25 = 1.97900390625 x 2^9, exponent 9 + 127 = 136 = 0x88, mantissa 0x7D5000 -> bits 0x447D5000; little-endian bytes 00 50 7D 44. FB = all zero bits = 0.",
    "expect": { "FA": { "raw": "1013.25", "physical": "1013.25" }, "FB": { "raw": "0", "physical": "0" } } },
  { "file": "09-float-signals.dbc", "id": 1792, "data": "00 00 C0 BF 00 00 C0 7F",
    "how": "0xBFC00000 = -1.5 (sign 1, exponent 127, mantissa 0.5). 0x7FC00000 is a quiet NaN.",
    "expect": { "FA": { "raw": "-1.5", "physical": "-1.5" }, "FB": { "raw": "NaN", "physical": "NaN" } } },
  { "file": "09-float-signals.dbc", "id": 1792, "data": "CD CC CC 3D 00 00 80 7F",
    "how": "0x3DCCCCCD is the single-precision number nearest to 0.1; the shortest decimal that reads back to it is 0.1. 0x7F800000 is +infinity.",
    "expect": { "FA": { "raw": "0.1", "physical": "0.1" }, "FB": { "raw": "Infinity", "physical": "Infinity" } } },
  { "file": "09-float-signals.dbc", "id": 1792, "data": "00 00 80 FF 00 00 00 80",
    "how": "0xFF800000 is -infinity. 0x80000000 is negative zero, shown as 0.",
    "expect": { "FA": { "raw": "-Infinity", "physical": "-Infinity" }, "FB": { "raw": "0", "physical": "0" } } },
  { "file": "09-float-signals.dbc", "id": 1792, "data": "F9 02 15 50 00 00 00 00",
    "how": "10^10 = 9765625 x 2^10: 24-bit significand 9765625, exponent 33 + 127 = 160 = 0xA0, mantissa field 9765625 - 2^23 = 1377017 = 0x1502F9 -> 0x501502F9.",
    "expect": { "FA": { "raw": "10000000000", "physical": "10000000000" } } },
  { "file": "09-float-signals.dbc", "id": 1793, "data": "18 2D 44 54 FB 21 09 40",
    "how": "0x400921FB54442D18 is pi as a double; shortest decimal that reads back: 3.141592653589793.",
    "expect": { "FD": { "raw": "3.141592653589793", "physical": "3.141592653589793" } } },
  { "file": "09-float-signals.dbc", "id": 1793, "data": "00 00 00 00 00 00 F0 3F", "how": "0x3FF0000000000000 = 1.", "expect": { "FD": { "raw": "1", "physical": "1" } } },
  { "file": "09-float-signals.dbc", "id": 1793, "data": "00 00 00 00 00 00 04 C0", "how": "0xC004000000000000 = -2.5.", "expect": { "FD": { "raw": "-2.5", "physical": "-2.5" } } },
  { "file": "09-float-signals.dbc", "id": 1793, "data": "9A 99 99 99 99 99 B9 3F", "how": "0x3FB999999999999A is the double nearest to 0.1; shortest decimal 0.1.", "expect": { "FD": { "raw": "0.1", "physical": "0.1" } } },
  { "file": "09-float-signals.dbc", "id": 1793, "data": "00 00 00 00 00 00 F0 7F", "how": "0x7FF0000000000000 is +infinity.", "expect": { "FD": { "raw": "Infinity" } } },
  { "file": "09-float-signals.dbc", "id": 1794, "data": "44 7D 50 00 BF C0 00 00",
    "how": "Big-endian floats: FM (start bit 7, bytes 0..3) = 0x447D5000 = 1013.25; FM2 (start bit 39, bytes 4..7) = 0xBFC00000 = -1.5.",
    "expect": { "FM": { "raw": "1013.25" }, "FM2": { "raw": "-1.5" } } },

  { "file": "10-float-scaled.dbc", "id": 1800, "data": "00 50 7D 44 00 00 00 00", "how": "1013.25 x 2 + 1 = 2027.5.", "expect": { "G32": { "raw": "1013.25", "physical": "2027.5" } } },
  { "file": "10-float-scaled.dbc", "id": 1800, "data": "00 00 C0 BF 00 00 00 00", "how": "-1.5 x 2 + 1 = -2.", "expect": { "G32": { "raw": "-1.5", "physical": "-2" } } },
  { "file": "10-float-scaled.dbc", "id": 1800, "data": "00 00 C0 7F 00 00 00 00", "how": "NaN stays NaN whatever the scaling.", "expect": { "G32": { "raw": "NaN", "physical": "NaN" } } },
  { "file": "10-float-scaled.dbc", "id": 1801, "data": "18 2D 44 54 FB 21 09 40", "how": "3.141592653589793 x 0.5 = 1.5707963267948965; minus 0.25 = 1.3207963267948965 (exact decimal arithmetic).",
    "expect": { "H64": { "raw": "3.141592653589793", "physical": "1.3207963267948965" } } },
  { "file": "10-float-scaled.dbc", "id": 1801, "data": "00 00 00 00 00 00 F0 3F", "how": "1 x 0.5 - 0.25 = 0.25.", "expect": { "H64": { "raw": "1", "physical": "0.25" } } },
  { "file": "10-float-scaled.dbc", "id": 1801, "data": "00 00 00 00 00 00 04 C0", "how": "-2.5 x 0.5 - 0.25 = -1.5.", "expect": { "H64": { "raw": "-2.5", "physical": "-1.5" } } },

  { "file": "11-value-tables.dbc", "id": 1024, "data": "FF 00",
    "how": "Sa = 0xFF as signed 8 bits = -1, described as Minus. Sb = 0 described as Zero.",
    "expect": { "Sa": { "raw": "-1", "text": "Minus" }, "Sb": { "raw": "0", "text": "Zero" } } },
  { "file": "11-value-tables.dbc", "id": 1024, "data": "00 FF",
    "how": "Sa = 0, Zero. Sb = -1: the table describes 255 (the bit pattern of -1 in 8 bits), so the description AllOnes is shown.",
    "expect": { "Sa": { "raw": "0", "text": "Zero" }, "Sb": { "raw": "-1", "text": "AllOnes" } } },
  { "file": "11-value-tables.dbc", "id": 1024, "data": "7F 80", "how": "Sa = 127, Max. Sb = 0x80 = -128, no description.", "expect": { "Sa": { "raw": "127", "text": "Max" }, "Sb": { "raw": "-128", "text": "" } } },
  { "file": "11-value-tables.dbc", "id": 1024, "data": "05 01", "how": "Values without a description have an empty text.", "expect": { "Sa": { "raw": "5", "text": "" }, "Sb": { "raw": "1", "text": "" } } },
  { "file": "11-value-tables.dbc", "id": 1025, "data": "FF FF FF FF FF FF FF FF", "how": "2^64 - 1 is described as Full.", "expect": { "U64v": { "raw": "18446744073709551615", "text": "Full" } } },
  { "file": "11-value-tables.dbc", "id": 1025, "data": "00 00 00 00 00 00 00 00", "how": "0 is described as Empty.", "expect": { "U64v": { "raw": "0", "text": "Empty" } } },
  { "file": "11-value-tables.dbc", "id": 1025, "data": "01 00 00 00 00 00 00 00", "how": "1 has no description.", "expect": { "U64v": { "raw": "1", "text": "" } } },
  { "file": "11-value-tables.dbc", "id": 1026, "data": "00 00 00 00 00 00 00 80", "how": "-2^63 is described as Lowest.", "expect": { "S64v": { "raw": "-9223372036854775808", "text": "Lowest" } } },
  { "file": "11-value-tables.dbc", "id": 1026, "data": "FF FF FF FF FF FF FF 7F", "how": "2^63 - 1 is described as Highest.", "expect": { "S64v": { "raw": "9223372036854775807", "text": "Highest" } } },
  { "file": "11-value-tables.dbc", "id": 1026, "data": "FF FF FF FF FF FF FF FF", "how": "-1 has no description.", "expect": { "S64v": { "raw": "-1", "text": "" } } }
]
