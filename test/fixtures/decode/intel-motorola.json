[
  { "file": "03-intel-basic.dbc", "id": 257, "data": "01 02 03 04 05 06 07 08",
    "how": "A = byte0 = 1. B = bytes 1,2 little-endian = 0x0302 = 770, x0.5 = 385. C = low nibble of byte3 = 4, D = high nibble = 0. E = bytes 4..7 little-endian = 0x08070605 = 134678021.",
    "expect": { "A": { "raw": "1", "physical": "1" }, "B": { "raw": "770", "physical": "385" }, "C": { "raw": "4", "physical": "4" }, "D": { "raw": "0", "physical": "0" }, "E": { "raw": "134678021", "physical": "134678021" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "FF FF FF FF FF FF FF FF",
    "how": "Every bit set: each signal is 2^length - 1. B = 65535 x 0.5 = 32767.5.",
    "expect": { "A": { "raw": "255", "physical": "255" }, "B": { "raw": "65535", "physical": "32767.5" }, "C": { "raw": "15", "physical": "15" }, "D": { "raw": "15", "physical": "15" }, "E": { "raw": "4294967295", "physical": "4294967295" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "00 00 00 A5 00 00 00 00",
    "how": "Byte3 = 0xA5: low nibble 5 is C, high nibble 0xA = 10 is D.",
    "expect": { "A": { "raw": "0" }, "C": { "raw": "5" }, "D": { "raw": "10" }, "E": { "raw": "0" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "80 00 00 00 00 00 00 80",
    "how": "A = 0x80 = 128. E = bytes 4..7 = 00 00 00 80 little-endian = 0x80000000 = 2147483648 (above the signed 32-bit range, so unsigned must hold).",
    "expect": { "A": { "raw": "128" }, "B": { "raw": "0" }, "E": { "raw": "2147483648", "physical": "2147483648" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "00 01 00 00 00 00 00 00",
    "how": "B = bytes 1,2 = 01 00 little-endian = 1, x0.5 = 0.5.",
    "expect": { "B": { "raw": "1", "physical": "0.5" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "00 00 80 00 00 00 00 00",
    "how": "Byte2 is the high byte of B: 0x8000 = 32768, x0.5 = 16384.",
    "expect": { "B": { "raw": "32768", "physical": "16384" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "00 FF 7F 00 00 00 00 00",
    "how": "B = 0x7FFF = 32767, x0.5 = 16383.5.",
    "expect": { "B": { "raw": "32767", "physical": "16383.5" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "00 00 00 00 12 34 56 78",
    "how": "E = bytes 4..7 little-endian = 0x78563412 = 2018915346.",
    "expect": { "E": { "raw": "2018915346" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "FF 00 00 0F 00 00 00 00",
    "how": "Byte3 = 0x0F: C = 15, D = 0. A = 255.",
    "expect": { "A": { "raw": "255" }, "C": { "raw": "15" }, "D": { "raw": "0" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "01 02 03",
    "how": "A frame of 3 bytes: A (byte 0) and B (bytes 1,2) fit and are decoded; C, D (byte 3) and E (bytes 4..7) are short.",
    "expect": { "A": { "raw": "1" }, "B": { "raw": "770", "physical": "385" }, "C": { "status": "short" }, "D": { "status": "short" }, "E": { "status": "short" } } },
  { "file": "03-intel-basic.dbc", "id": 257, "data": "",
    "how": "An empty frame: nothing fits.",
    "expect": { "A": { "status": "short" }, "E": { "status": "short" } } },

  { "file": "03-intel-basic.dbc", "id": 258, "data": "FF FF FF FF FF FF FF FF",
    "how": "X1 = 9 bits, X2 = 11, X3 = 7, X4 = 13, X5 = 19 bits, all ones: 511, 2047, 127, 8191, 524287.",
    "expect": { "X1": { "raw": "511" }, "X2": { "raw": "2047" }, "X3": { "raw": "127" }, "X4": { "raw": "8191" }, "X5": { "raw": "524287" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "20 00 00 00 00 00 00 00",
    "how": "0x20 = bit 5 of byte 0 = frame bit 5 = the least significant bit of X1.",
    "expect": { "X1": { "raw": "1" }, "X2": { "raw": "0" }, "X3": { "raw": "0" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "00 40 00 00 00 00 00 00",
    "how": "0x40 in byte 1 = frame bit 14 = least significant bit of X2 (X1 stops at bit 13).",
    "expect": { "X1": { "raw": "0" }, "X2": { "raw": "1" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "00 20 00 00 00 00 00 00",
    "how": "0x20 in byte 1 = frame bit 13 = the most significant bit of X1 (bit index 13-5 = 8): 2^8 = 256.",
    "expect": { "X1": { "raw": "256" }, "X2": { "raw": "0" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "00 00 00 FE 00 00 00 00",
    "how": "Byte3 = 0xFE: bits 25..31 set, bit 24 clear. X3 = 127, X2 (bits 14..24) = 0.",
    "expect": { "X2": { "raw": "0" }, "X3": { "raw": "127" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "00 00 00 01 00 00 00 00",
    "how": "Bit 24 is the most significant bit of X2 (bit index 24-14 = 10): 1024.",
    "expect": { "X2": { "raw": "1024" }, "X3": { "raw": "0" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "00 00 00 00 00 20 00 00",
    "how": "Byte5 = 0x20 = frame bit 45 = least significant bit of X5.",
    "expect": { "X4": { "raw": "0" }, "X5": { "raw": "1" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "00 00 00 00 00 00 00 80",
    "how": "Frame bit 63 = most significant bit of X5 (index 63-45 = 18): 2^18 = 262144.",
    "expect": { "X5": { "raw": "262144" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "00 00 00 00 FF 1F 00 00",
    "how": "Bits 32..44 set: X4 = 8191; bit 45 clear so X5 = 0.",
    "expect": { "X4": { "raw": "8191" }, "X5": { "raw": "0" } } },
  { "file": "03-intel-basic.dbc", "id": 258, "data": "40 00 00 00 00 00 00 00",
    "how": "Frame bit 6 is bit index 1 of X1: 2.",
    "expect": { "X1": { "raw": "2" } } },

  { "file": "04-motorola-basic.dbc", "id": 512, "data": "12 34 00 00 00 00 00 00",
    "how": "P: start bit 7 is the MOST significant bit, bytes are read big-endian: 0x1234 = 4660.",
    "expect": { "P": { "raw": "4660", "physical": "4660" } } },
  { "file": "04-motorola-basic.dbc", "id": 512, "data": "01 02 00 00 00 00 00 00",
    "how": "Big-endian 0x0102 = 258. A little-endian reading would give 0x0201 = 513 (the classic mistake).",
    "expect": { "P": { "raw": "258" } } },
  { "file": "04-motorola-basic.dbc", "id": 512, "data": "FF FF 00 00 00 00 00 00", "how": "0xFFFF = 65535.", "expect": { "P": { "raw": "65535" } } },
  { "file": "04-motorola-basic.dbc", "id": 512, "data": "00 01 00 00 00 00 00 00", "how": "0x0001 = 1.", "expect": { "P": { "raw": "1" } } },
  { "file": "04-motorola-basic.dbc", "id": 512, "data": "80 00 00 00 00 00 00 00", "how": "0x8000 = 32768.", "expect": { "P": { "raw": "32768" } } },

  { "file": "04-motorola-basic.dbc", "id": 513, "data": "01 FE 00 00 00 00 00 00",
    "how": "Q: start bit 0 is the MSB: it is bit 0 of byte 0, then bits 7..1 of byte 1. Byte0 bit0 = 1 gives 128; byte1 0xFE >> 1 = 127. Q = 255.",
    "expect": { "Q": { "raw": "255" } } },
  { "file": "04-motorola-basic.dbc", "id": 513, "data": "01 00 00 00 00 00 00 00", "how": "Byte0 bit 0 alone = 2^7 = 128.", "expect": { "Q": { "raw": "128" } } },
  { "file": "04-motorola-basic.dbc", "id": 513, "data": "00 02 00 00 00 00 00 00", "how": "Byte1 bit 1 is the least significant bit of Q = 1.", "expect": { "Q": { "raw": "1" } } },
  { "file": "04-motorola-basic.dbc", "id": 513, "data": "00 01 00 00 00 00 00 00", "how": "Byte1 bit 0 is not part of Q: 0.", "expect": { "Q": { "raw": "0" } } },
  { "file": "04-motorola-basic.dbc", "id": 513, "data": "01 80 00 00 00 00 00 00", "how": "128 + (0x80 >> 1 = 64) = 192.", "expect": { "Q": { "raw": "192" } } },
  { "file": "04-motorola-basic.dbc", "id": 513, "data": "FE 00 00 00 00 00 00 00", "how": "Bits 7..1 of byte 0 are not part of Q: 0.", "expect": { "Q": { "raw": "0" } } },
  { "file": "04-motorola-basic.dbc", "id": 513, "data": "00 FF 00 00 00 00 00 00", "how": "0xFF >> 1 = 127.", "expect": { "Q": { "raw": "127" } } },

  { "file": "04-motorola-basic.dbc", "id": 514, "data": "1F FF FF 00 00 00 00 00",
    "how": "S has 20 bits: bits 4..0 of byte0, all of byte1, bits 7..1 of byte2. All ones = 2^20 - 1 = 1048575.",
    "expect": { "S": { "raw": "1048575" } } },
  { "file": "04-motorola-basic.dbc", "id": 514, "data": "01 00 00 00 00 00 00 00", "how": "Byte0 bit 0 is bit 15 of S: 32768.", "expect": { "S": { "raw": "32768" } } },
  { "file": "04-motorola-basic.dbc", "id": 514, "data": "00 01 00 00 00 00 00 00", "how": "Byte1 bit 0 is bit 7 of S: 128.", "expect": { "S": { "raw": "128" } } },
  { "file": "04-motorola-basic.dbc", "id": 514, "data": "00 00 02 00 00 00 00 00", "how": "Byte2 bit 1 is the least significant bit of S: 1.", "expect": { "S": { "raw": "1" } } },
  { "file": "04-motorola-basic.dbc", "id": 514, "data": "A5 5A 3C 00 00 00 00 00",
    "how": "(0xA5 & 0x1F = 5) << 15 = 163840; 0x5A = 90, 90 << 7 = 11520; 0x3C >> 1 = 30. Sum = 175390.",
    "expect": { "S": { "raw": "175390" } } },
  { "file": "04-motorola-basic.dbc", "id": 514, "data": "E0 00 01 00 00 00 00 00", "how": "Bits 7..5 of byte0 and bit 0 of byte2 are outside S: 0.", "expect": { "S": { "raw": "0" } } },

  { "file": "04-motorola-basic.dbc", "id": 515, "data": "11 22 01 02 03 FF FF B4",
    "how": "X = byte0 = 0x11 = 17. U = byte1 = 0x22 = 34. W = bytes 2..4 big-endian = 0x010203 = 66051. Byte7 = 0xB4: V (start 63, bits 7..4) = 0xB = 11, T (start 59, bits 3..0) = 4.",
    "expect": { "X": { "raw": "17" }, "U": { "raw": "34" }, "W": { "raw": "66051" }, "T": { "raw": "4" }, "V": { "raw": "11" } } },
  { "file": "04-motorola-basic.dbc", "id": 515, "data": "00 00 FF FF FF 00 00 0F", "how": "W = 0xFFFFFF = 16777215; byte7 = 0x0F: T = 15, V = 0.",
    "expect": { "W": { "raw": "16777215" }, "T": { "raw": "15" }, "V": { "raw": "0" } } },
  { "file": "04-motorola-basic.dbc", "id": 515, "data": "80 00 00 00 00 00 00 F0", "how": "X = 128; byte7 = 0xF0: V = 15, T = 0.",
    "expect": { "X": { "raw": "128" }, "V": { "raw": "15" }, "T": { "raw": "0" } } },
  { "file": "04-motorola-basic.dbc", "id": 515, "data": "FF FF 00 00 01 FF FF 00", "how": "W = bytes 2..4 = 00 00 01 = 1.", "expect": { "W": { "raw": "1" }, "T": { "raw": "0" } } },
  { "file": "04-motorola-basic.dbc", "id": 515, "data": "11 22 01 02 03", "how": "A frame of 5 bytes: X, U, W fit; T and V (byte 7) are short.",
    "expect": { "X": { "raw": "17" }, "W": { "raw": "66051" }, "T": { "status": "short" }, "V": { "status": "short" } } },

  { "file": "05-bit-signals.dbc", "id": 768, "data": "80 00 00 00 00 00 00 00",
    "how": "M0 is bit 7 of byte 0 (Motorola, 1 bit): 1. I0 is bit 0: 0.",
    "expect": { "I0": { "raw": "0" }, "M0": { "raw": "1" }, "I1": { "raw": "0" }, "M1": { "raw": "0" }, "I2": { "raw": "0" }, "M2": { "raw": "0" } } },
  { "file": "05-bit-signals.dbc", "id": 768, "data": "01 02 81 80 00 00 00 00",
    "how": "Byte0 = 01: I0 = 1, M0 = 0. Byte1 = 02: bit 1 -> I1 = 1. Byte2 = 81: bit 0 -> M1 = 1, bit 7 -> I2 = 1. Byte3 = 80: bit 7 -> M2 = 1.",
    "expect": { "I0": { "raw": "1" }, "M0": { "raw": "0" }, "I1": { "raw": "1" }, "M1": { "raw": "1" }, "I2": { "raw": "1" }, "M2": { "raw": "1" } } },
  { "file": "05-bit-signals.dbc", "id": 768, "data": "FF FF FF FF 00 00 00 00", "how": "All six bits set.",
    "expect": { "I0": { "raw": "1" }, "I1": { "raw": "1" }, "M0": { "raw": "1" }, "M1": { "raw": "1" }, "I2": { "raw": "1" }, "M2": { "raw": "1" } } },
  { "file": "05-bit-signals.dbc", "id": 768, "data": "7E FD 7E 7F 00 00 00 00", "how": "Every other bit of those bytes is set but not the six bits of the signals: bit0 and bit7 of byte0, bit1 of byte1, bit0 and bit7 of byte2, bit7 of byte3 are all clear.",
    "expect": { "I0": { "raw": "0" }, "I1": { "raw": "0" }, "M0": { "raw": "0" }, "M1": { "raw": "0" }, "I2": { "raw": "0" }, "M2": { "raw": "0" } } },
  { "file": "05-bit-signals.dbc", "id": 768, "data": "00 00 00 00 00 00 00 00", "how": "All zero.",
    "expect": { "I0": { "raw": "0" }, "M2": { "raw": "0" } } },

  { "file": "06-wide-signals.dbc", "id": 1024, "data": "FF FF FF FF FF FF FF FF", "how": "2^64 - 1 = 18446744073709551615 (does not fit a double).",
    "expect": { "U64": { "raw": "18446744073709551615", "physical": "18446744073709551615" } } },
  { "file": "06-wide-signals.dbc", "id": 1024, "data": "01 00 00 00 00 00 00 00", "how": "1.", "expect": { "U64": { "raw": "1" } } },
  { "file": "06-wide-signals.dbc", "id": 1024, "data": "00 00 00 00 00 00 00 80", "how": "Byte7 = 0x80: 2^63 = 9223372036854775808.", "expect": { "U64": { "raw": "9223372036854775808" } } },
  { "file": "06-wide-signals.dbc", "id": 1024, "data": "88 77 66 55 44 33 22 11", "how": "Little-endian 0x1122334455667788 = 1234605616436508552.", "expect": { "U64": { "raw": "1234605616436508552" } } },
  { "file": "06-wide-signals.dbc", "id": 1025, "data": "FF FF FF FF FF FF FF FF", "how": "Big-endian signed 64 bits, all ones = -1.", "expect": { "M64S": { "raw": "-1", "physical": "-1" } } },
  { "file": "06-wide-signals.dbc", "id": 1025, "data": "80 00 00 00 00 00 00 00", "how": "-2^63 = -9223372036854775808.", "expect": { "M64S": { "raw": "-9223372036854775808" } } },
  { "file": "06-wide-signals.dbc", "id": 1025, "data": "7F FF FF FF FF FF FF FF", "how": "2^63 - 1 = 9223372036854775807.", "expect": { "M64S": { "raw": "9223372036854775807" } } },
  { "file": "06-wide-signals.dbc", "id": 1025, "data": "01 02 03 04 05 06 07 08", "how": "Big-endian 0x0102030405060708 = 72623859790382856.", "expect": { "M64S": { "raw": "72623859790382856" } } },
  { "file": "06-wide-signals.dbc", "id": 1026, "data": "FF FF FF FF FF FF FF FF", "how": "63 bits (frame bits 1..63) all set: 2^63 - 1.", "expect": { "L63": { "raw": "9223372036854775807" } } },
  { "file": "06-wide-signals.dbc", "id": 1026, "data": "02 00 00 00 00 00 00 00", "how": "Frame bit 1 is the least significant bit of L63: 1.", "expect": { "L63": { "raw": "1" } } },
  { "file": "06-wide-signals.dbc", "id": 1026, "data": "01 00 00 00 00 00 00 00", "how": "Frame bit 0 is outside L63: 0.", "expect": { "L63": { "raw": "0" } } },
  { "file": "06-wide-signals.dbc", "id": 1027, "data": "7F FF FF FF FF FF FF FF", "how": "N63 = the 63 bits after the top bit of the big-endian 64-bit value: 0x7FFF... = 2^63 - 1.", "expect": { "N63": { "raw": "9223372036854775807" } } },
  { "file": "06-wide-signals.dbc", "id": 1027, "data": "80 00 00 00 00 00 00 00", "how": "The top bit (bit 7 of byte 0) is outside N63: 0.", "expect": { "N63": { "raw": "0" } } },
  { "file": "06-wide-signals.dbc", "id": 1027, "data": "40 00 00 00 00 00 00 01", "how": "Big-endian 0x4000000000000001 = 4611686018427387905 (the top bit is clear).", "expect": { "N63": { "raw": "4611686018427387905" } } },
  { "file": "06-wide-signals.dbc", "id": 1027, "data": "00 00 00 00 00 00 00 01", "how": "1.", "expect": { "N63": { "raw": "1" } } },
  { "file": "06-wide-signals.dbc", "id": 1028, "data": "FF FF FF FF FF FF FF FF", "how": "raw 18446744073709551615 x 0.001 = 18446744073709551.615 exactly (a double cannot hold it).",
    "expect": { "D64": { "raw": "18446744073709551615", "physical": "18446744073709551.615" } } },
  { "file": "06-wide-signals.dbc", "id": 1028, "data": "01 00 00 00 00 00 00 00", "how": "1 x 0.001 = 0.001.", "expect": { "D64": { "raw": "1", "physical": "0.001" } } },
  { "file": "06-wide-signals.dbc", "id": 1028, "data": "E8 03 00 00 00 00 00 00", "how": "0x03E8 = 1000, x 0.001 = 1.", "expect": { "D64": { "raw": "1000", "physical": "1" } } },
  { "file": "06-wide-signals.dbc", "id": 1028, "data": "10 27 00 00 00 00 00 00", "how": "0x2710 = 10000, x 0.001 = 10.", "expect": { "D64": { "raw": "10000", "physical": "10" } } },
  { "file": "06-wide-signals.dbc", "id": 1029, "data": "FF FF FF FF FF FF FF FF", "how": "Little-endian signed 64 bits, all ones = -1.", "expect": { "S64": { "raw": "-1" } } },
  { "file": "06-wide-signals.dbc", "id": 1029, "data": "00 00 00 00 00 00 00 80", "how": "-2^63.", "expect": { "S64": { "raw": "-9223372036854775808" } } },
  { "file": "06-wide-signals.dbc", "id": 1029, "data": "FF FF FF FF FF FF FF 7F", "how": "2^63 - 1.", "expect": { "S64": { "raw": "9223372036854775807" } } },
  { "file": "06-wide-signals.dbc", "id": 1029, "data": "FE FF FF FF FF FF FF FF", "how": "-2.", "expect": { "S64": { "raw": "-2" } } }
]
