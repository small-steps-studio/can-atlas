[
  { "file": "13-multiplex-simple.dbc", "id": 1100, "data": "00 34 12 07 00 00 00 99",
    "how": "Sel = 0: A (m0) = bytes 1,2 = 0x1234 = 4660, C (m0) = 7; B (m1) is absent. D is always present = 0x99 = 153.",
    "expect": { "Sel": { "raw": "0" }, "A": { "raw": "4660" }, "B": { "status": "absent" }, "C": { "raw": "7" }, "D": { "raw": "153" } } },
  { "file": "13-multiplex-simple.dbc", "id": 1100, "data": "01 34 12 07 00 00 00 99",
    "how": "Sel = 1: B (m1) = 4660 x 0.1 = 466; A and C are absent.",
    "expect": { "Sel": { "raw": "1" }, "A": { "status": "absent" }, "B": { "raw": "4660", "physical": "466" }, "C": { "status": "absent" }, "D": { "raw": "153" } } },
  { "file": "13-multiplex-simple.dbc", "id": 1100, "data": "02 34 12 07 00 00 00 99", "how": "Sel = 2 selects nothing.",
    "expect": { "A": { "status": "absent" }, "B": { "status": "absent" }, "C": { "status": "absent" }, "D": { "raw": "153" } } },
  { "file": "13-multiplex-simple.dbc", "id": 1100, "data": "FF 34 12 07 00 00 00 01", "how": "Sel = 255 selects nothing; D = 1.",
    "expect": { "Sel": { "raw": "255" }, "A": { "status": "absent" }, "B": { "status": "absent" }, "C": { "status": "absent" }, "D": { "raw": "1" } } },
  { "file": "13-multiplex-simple.dbc", "id": 1100, "data": "00 34",
    "how": "A frame of two bytes with Sel = 0: Sel fits; A needs bytes 1,2 (short); C and D are short.",
    "expect": { "Sel": { "raw": "0" }, "A": { "status": "short" }, "C": { "status": "short" }, "D": { "status": "short" } } },
  { "file": "13-multiplex-simple.dbc", "id": 1100, "data": "",
    "how": "An empty frame: the multiplexor itself is short, so every multiplexed signal is short too (never guessed).",
    "expect": { "Sel": { "status": "short" }, "A": { "status": "short" }, "B": { "status": "short" } } },

  { "file": "14-multiplex-eight.dbc", "id": 1101, "data": "FD AA 00 00 00 00 00 00", "how": "Sel is the low 3 bits of 0xFD = 0b101 = 5 (the other bits belong to no signal): V5 = 0xAA = 170.",
    "expect": { "Sel": { "raw": "5" }, "V5": { "raw": "170" }, "V0": { "status": "absent" }, "V4": { "status": "absent" }, "V6": { "status": "absent" }, "V7": { "status": "absent" } } },
  { "file": "14-multiplex-eight.dbc", "id": 1101, "data": "07 01 00 00 00 00 00 00", "how": "Sel = 7: V7 = 1.", "expect": { "Sel": { "raw": "7" }, "V7": { "raw": "1" }, "V6": { "status": "absent" } } },
  { "file": "14-multiplex-eight.dbc", "id": 1101, "data": "F8 FF 00 00 00 00 00 00", "how": "0xF8 & 7 = 0: V0 = 255.", "expect": { "Sel": { "raw": "0" }, "V0": { "raw": "255" }, "V1": { "status": "absent" } } },
  { "file": "14-multiplex-eight.dbc", "id": 1101, "data": "03 10 00 00 00 00 00 00", "how": "Sel = 3: V3 = 16.", "expect": { "V3": { "raw": "16" }, "V2": { "status": "absent" } } },

  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "02 11 22 00 00 00 00 00", "how": "Sel = 2 lies in A's range 0-3: A = 0x11 = 17; B (5, 7-9) and C (9-12) absent.",
    "expect": { "A": { "raw": "17" }, "B": { "status": "absent" }, "C": { "status": "absent" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "08 11 22 00 00 00 00 00", "how": "Sel = 8: only B (range 7-9) is present = 0x22 = 34.",
    "expect": { "A": { "status": "absent" }, "B": { "raw": "34" }, "C": { "status": "absent" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "0A 11 22 00 00 00 00 00", "how": "Sel = 10: only C (range 9-12) = 0x11 = 17.",
    "expect": { "A": { "status": "absent" }, "B": { "status": "absent" }, "C": { "raw": "17" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "0C 11 22 00 00 00 00 00", "how": "Sel = 12: C present.", "expect": { "B": { "status": "absent" }, "C": { "raw": "17" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "0D 11 22 00 00 00 00 00", "how": "Sel = 13: nothing is selected.", "expect": { "A": { "status": "absent" }, "B": { "status": "absent" }, "C": { "status": "absent" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "09 11 22 00 00 00 00 00", "how": "Sel = 9 is in two ranges: B (7-9) = 34 and C (9-12) = 17 are both present (different bytes).",
    "expect": { "A": { "status": "absent" }, "B": { "raw": "34" }, "C": { "raw": "17" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "05 11 22 00 00 00 00 00", "how": "Sel = 5: B (5-5).", "expect": { "A": { "status": "absent" }, "B": { "raw": "34" }, "C": { "status": "absent" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "04 11 22 00 00 00 00 00", "how": "Sel = 4: nothing.", "expect": { "A": { "status": "absent" }, "B": { "status": "absent" }, "C": { "status": "absent" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "07 11 22 00 00 00 00 00", "how": "Sel = 7: B (7-9).", "expect": { "B": { "raw": "34" } } },
  { "file": "15-multiplex-extended-simple.dbc", "id": 1102, "data": "06 11 22 00 00 00 00 00", "how": "Sel = 6: between B's ranges, nothing.", "expect": { "B": { "status": "absent" } } },

  { "file": "16-multiplex-extended-nested.dbc", "id": 1103, "data": "00 AA BB CC 00 00 00 00",
    "how": "Sel = 0 (low nibble), so X (Sel 0) = 0xAA = 170 is present; Sub (present only when Sel = 1), Y, Z, W are absent.",
    "expect": { "Sel": { "raw": "0" }, "Sub": { "status": "absent" }, "X": { "raw": "170" }, "Y": { "status": "absent" }, "Z": { "status": "absent" }, "W": { "status": "absent" } } },
  { "file": "16-multiplex-extended-nested.dbc", "id": 1103, "data": "01 AA BB CC 00 00 00 00",
    "how": "Sel = 1, Sub = 0 (high nibble): Y = 170; Z (Sub 0-3) = 0xBB = 187; W (Sub 2) absent; X absent.",
    "expect": { "Sel": { "raw": "1" }, "Sub": { "raw": "0" }, "X": { "status": "absent" }, "Y": { "raw": "170" }, "Z": { "raw": "187" }, "W": { "status": "absent" } } },
  { "file": "16-multiplex-extended-nested.dbc", "id": 1103, "data": "21 AA BB CC 00 00 00 00",
    "how": "Sel = 1, Sub = 2: Y = 170, Z = 187, W = 0xCC = 204.",
    "expect": { "Sub": { "raw": "2" }, "Y": { "raw": "170" }, "Z": { "raw": "187" }, "W": { "raw": "204" } } },
  { "file": "16-multiplex-extended-nested.dbc", "id": 1103, "data": "41 AA BB CC 00 00 00 00",
    "how": "Sel = 1, Sub = 4: Y present; Z (Sub 0-3) and W (Sub 2) absent.",
    "expect": { "Sub": { "raw": "4" }, "Y": { "raw": "170" }, "Z": { "status": "absent" }, "W": { "status": "absent" } } },
  { "file": "16-multiplex-extended-nested.dbc", "id": 1103, "data": "32 AA BB CC 00 00 00 00",
    "how": "Sel = 2: Sub, X, Y, Z, W are all absent (the high nibble 3 is not Sub because Sub exists only when Sel = 1).",
    "expect": { "Sel": { "raw": "2" }, "Sub": { "status": "absent" }, "X": { "status": "absent" }, "Y": { "status": "absent" }, "Z": { "status": "absent" }, "W": { "status": "absent" } } },
  { "file": "16-multiplex-extended-nested.dbc", "id": 1103, "data": "F1 AA BB CC 00 00 00 00", "how": "Sel = 1, Sub = 15: Y only.",
    "expect": { "Sub": { "raw": "15" }, "Y": { "raw": "170" }, "Z": { "status": "absent" }, "W": { "status": "absent" } } },
  { "file": "16-multiplex-extended-nested.dbc", "id": 1103, "data": "31 AA BB CC 00 00 00 00", "how": "Sel = 1, Sub = 3: Y and Z (0-3) present, W absent.",
    "expect": { "Sub": { "raw": "3" }, "Y": { "raw": "170" }, "Z": { "raw": "187" }, "W": { "status": "absent" } } },

  { "file": "17-multiplex-three-level.dbc", "id": 1104, "data": "39 77 88 00 00 00 00 00",
    "how": "0x39 = 0b00111001: M0 = bits 1..0 = 1, M1 = bits 3..2 = 2, M2 = bits 5..4 = 3. S needs M0 = 1, M1 = 2, M2 = 3: S = 0x77 = 119. T (M0 = 0) absent.",
    "expect": { "M0": { "raw": "1" }, "M1": { "raw": "2" }, "M2": { "raw": "3" }, "S": { "raw": "119" }, "T": { "status": "absent" } } },
  { "file": "17-multiplex-three-level.dbc", "id": 1104, "data": "29 77 88 00 00 00 00 00",
    "how": "0x29 = 0b00101001: M0 = 1, M1 = 2, M2 = 2: M2 is present but S needs M2 = 3.",
    "expect": { "M0": { "raw": "1" }, "M1": { "raw": "2" }, "M2": { "raw": "2" }, "S": { "status": "absent" } } },
  { "file": "17-multiplex-three-level.dbc", "id": 1104, "data": "05 77 88 00 00 00 00 00",
    "how": "0x05: M0 = 1, M1 = 1; M2 exists only when M1 = 2, so M2 and S are absent.",
    "expect": { "M0": { "raw": "1" }, "M1": { "raw": "1" }, "M2": { "status": "absent" }, "S": { "status": "absent" } } },
  { "file": "17-multiplex-three-level.dbc", "id": 1104, "data": "00 77 88 00 00 00 00 00", "how": "M0 = 0: T = 0x88 = 136; M1, M2, S absent.",
    "expect": { "M0": { "raw": "0" }, "M1": { "status": "absent" }, "M2": { "status": "absent" }, "S": { "status": "absent" }, "T": { "raw": "136" } } },
  { "file": "17-multiplex-three-level.dbc", "id": 1104, "data": "3C 77 88 00 00 00 00 00", "how": "0x3C = 0b00111100: M0 = 0, so only T is present although the other bits look like M1 = 3, M2 = 3.",
    "expect": { "M0": { "raw": "0" }, "M1": { "status": "absent" }, "M2": { "status": "absent" }, "S": { "status": "absent" }, "T": { "raw": "136" } } },
  { "file": "17-multiplex-three-level.dbc", "id": 1104, "data": "02 77 88 00 00 00 00 00", "how": "M0 = 2 selects nothing.",
    "expect": { "M0": { "raw": "2" }, "M1": { "status": "absent" }, "T": { "status": "absent" } } },

  { "file": "18-mux-ambiguous.dbc", "id": 1105, "data": "21 55 00 00 00 00 00 00", "how": "Two multiplexors and no SG_MUL_VAL_: both switches are read, the signal below is not decoded (never guessed).",
    "expect": { "Sel1": { "raw": "1" }, "Sel2": { "raw": "2" }, "Data": { "status": "undecodable" } } },
  { "file": "19-mux-float-switch.dbc", "id": 1106, "data": "00 00 80 3F 07 00 00 00", "how": "The float multiplexor 0x3F800000 = 1 is read; the signal it should select is not decoded.",
    "expect": { "Sel": { "raw": "1" }, "A": { "status": "undecodable" } } },
  { "file": "20-mux-loop.dbc", "id": 1107, "data": "00 11 00 00 00 00 00 00", "how": "Multiplexors that select each other, and the signal below them, are not decoded.",
    "expect": { "A": { "status": "undecodable" }, "B": { "status": "undecodable" }, "C": { "status": "undecodable" } } },

  { "file": "22-extended-ids.dbc", "id": 2566844672, "data": "34 12 78 56 00 00 00 00", "how": "Raw DBC ID 0x98FEF100 = flag bit 31 + extended identifier 0x18FEF100. E1 = 0x1234 = 4660, E2 = 0x5678 = 22136.",
    "expect": { "E1": { "raw": "4660" }, "E2": { "raw": "22136" } } },
  { "file": "22-extended-ids.dbc", "id": 2147483649, "data": "AB 00 00 00 00 00 00 00", "how": "Extended identifier 1.", "expect": { "E3": { "raw": "171" } } },
  { "file": "22-extended-ids.dbc", "id": 2684354559, "data": "FF 00 00 00 00 00 00 00", "how": "Extended identifier 0x1FFFFFFF, the largest one.", "expect": { "E4": { "raw": "255" } } },
  { "file": "22-extended-ids.dbc", "id": 2047, "data": "01 00 00 00 00 00 00 00", "how": "Standard identifier 0x7FF, the largest one.", "expect": { "E5": { "raw": "1" } } },
  { "file": "22-extended-ids.dbc", "id": 0, "data": "02 00 00 00 00 00 00 00", "how": "Identifier 0.", "expect": { "E6": { "raw": "2" } } },

  { "file": "24-dlc-values.dbc", "id": 1201, "data": "01 02 03 04 05 06 07 08", "how": "D8 uses all 64 bits little-endian: 0x0807060504030201 = 578437695752307201.", "expect": { "D8": { "raw": "578437695752307201" } } },
  { "file": "24-dlc-values.dbc", "id": 1202, "data": "01 00 00 00 00 00 00 00 00 00 00 7B", "how": "12-byte frame: H0 = byte0 = 1; H1 = byte 11 = 0x7B = 123 (bit 88).", "expect": { "H0": { "raw": "1" }, "H1": { "raw": "123" } } },
  { "file": "24-dlc-values.dbc", "id": 1202, "data": "01 02 03 04", "how": "A 12-byte message that arrives with only 4 bytes: H0 is decoded, H1 (byte 11) is short.", "expect": { "H0": { "raw": "1" }, "H1": { "status": "short" } } },
  { "file": "24-dlc-values.dbc", "id": 1203, "fill": { "length": 24, "bytes": { "23": "C8" } }, "how": "24-byte frame, byte 23 = 0xC8 = 200 (bit 184).", "expect": { "U0": { "raw": "200" } } },
  { "file": "24-dlc-values.dbc", "id": 1204, "fill": { "length": 64, "bytes": { "63": "AB", "31": "12", "32": "34" } }, "how": "64-byte frame: Z0 = byte 63 = 0xAB = 171; Z1 (Motorola, start bit 255) = bytes 31,32 big-endian = 0x1234 = 4660.",
    "expect": { "Z0": { "raw": "171" }, "Z1": { "raw": "4660" } } },
  { "file": "24-dlc-values.dbc", "id": 1204, "fill": { "length": 40, "bytes": { "31": "12", "32": "34" } }, "how": "A 64-byte message that arrives with 40 bytes: Z1 (bytes 31,32) fits, Z0 (byte 63) is short.",
    "expect": { "Z1": { "raw": "4660" }, "Z0": { "status": "short" } } },
  { "file": "24-dlc-values.dbc", "id": 1205, "data": "05 00 00 00 00 00 00 00 00", "how": "A message of 9 bytes (not a frame length, reported by the checks) still decodes: Y = 5.", "expect": { "Y": { "raw": "5" } } }
]
