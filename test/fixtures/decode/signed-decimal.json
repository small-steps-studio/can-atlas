  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 01 00 00 00 00 00 00", "how": "S12 = 1; physical 0.5 - 10 = -9.5.", "expect": { "S12": { "raw": "1", "physical": "-9.5" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 00 F0 00 00 00 00 00", "how": "The high nibble of byte 2 (bits 20..23) belongs to no signal: S12 = 0, S16 = 0.",
    "expect": { "S12": { "raw": "0", "physical": "-10" }, "S16": { "raw": "0" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 00 00 FF FF 00 00 00", "how": "S16 = bytes 3,4 = 0xFFFF -> -1.", "expect": { "S16": { "raw": "-1" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 00 00 00 80 00 00 00", "how": "S16 = 0x8000 -> -32768.", "expect": { "S16": { "raw": "-32768" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 00 00 FF 7F 00 00 00", "how": "S16 = 0x7FFF = 32767.", "expect": { "S16": { "raw": "32767" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 00 00 01 00 00 00 00", "how": "S16 = 1.", "expect": { "S16": { "raw": "1" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 00 00 00 FF 00 00 00", "how": "S16 = 0xFF00 -> -256.", "expect": { "S16": { "raw": "-256" } } },

  { "file": "07-signed-values.dbc", "id": 1281, "data": "FF FF FF FF 00 00 00 00", "how": "S32I = -1; S32M = 0.", "expect": { "S32I": { "raw": "-1" }, "S32M": { "raw": "0" } } },
  { "file": "07-signed-values.dbc", "id": 1281, "data": "00 00 00 80 00 00 00 00", "how": "S32I = 0x80000000 -> -2147483648.", "expect": { "S32I": { "raw": "-2147483648" } } },
  { "file": "07-signed-values.dbc", "id": 1281, "data": "FF FF FF 7F 00 00 00 00", "how": "S32I = 2147483647.", "expect": { "S32I": { "raw": "2147483647" } } },
  { "file": "07-signed-values.dbc", "id": 1281, "data": "00 00 00 00 FF FF FF FF", "how": "S32M (big-endian, start bit 39 = byte 4 bit 7) = -1; S32I = 0.", "expect": { "S32M": { "raw": "-1" }, "S32I": { "raw": "0" } } },
  { "file": "07-signed-values.dbc", "id": 1281, "data": "00 00 00 00 80 00 00 00", "how": "S32M = 0x80000000 -> -2147483648.", "expect": { "S32M": { "raw": "-2147483648" } } },
  { "file": "07-signed-values.dbc", "id": 1281, "data": "00 00 00 00 7F FF FF FF", "how": "S32M = 2147483647.", "expect": { "S32M": { "raw": "2147483647" } } },
  { "file": "07-signed-values.dbc", "id": 1281, "data": "00 00 00 00 00 00 00 05", "how": "S32M = 5 (last byte is the least significant one).", "expect": { "S32M": { "raw": "5" } } },
  { "file": "07-signed-values.dbc", "id": 1281, "data": "00 00 00 00 FF FF FF FE", "how": "S32M = 0xFFFFFFFE -> -2.", "expect": { "S32M": { "raw": "-2" } } },

  { "file": "07-signed-values.dbc", "id": 1282, "data": "00 00 00 00 00 00 00 00", "how": "NF = 0 x -0.5 + 100 = 100. NF2 = 0 x -1 = 0. NO = 0 - 40 = -40.",
    "expect": { "NF": { "raw": "0", "physical": "100" }, "NF2": { "raw": "0", "physical": "0" }, "NO": { "raw": "0", "physical": "-40" } } },
  { "file": "07-signed-values.dbc", "id": 1282, "data": "FF FF FF 00 00 00 00 00", "how": "NF = 255 x -0.5 + 100 = -27.5. NF2 = -1 x -1 = 1. NO = 255 - 40 = 215.",
    "expect": { "NF": { "raw": "255", "physical": "-27.5" }, "NF2": { "raw": "-1", "physical": "1" }, "NO": { "raw": "255", "physical": "215" } } },
  { "file": "07-signed-values.dbc", "id": 1282, "data": "02 80 64 00 00 00 00 00", "how": "NF = 2 x -0.5 + 100 = 99. NF2 = -128 x -1 = 128. NO = 100 - 40 = 60.",
    "expect": { "NF": { "raw": "2", "physical": "99" }, "NF2": { "raw": "-128", "physical": "128" }, "NO": { "raw": "100", "physical": "60" } } },
  { "file": "07-signed-values.dbc", "id": 1282, "data": "03 7F 00 00 00 00 00 00", "how": "NF = 3 x -0.5 + 100 = 98.5. NF2 = 127 x -1 = -127.",
    "expect": { "NF": { "raw": "3", "physical": "98.5" }, "NF2": { "raw": "127", "physical": "-127" } } },

  { "file": "08-exact-decimals.dbc", "id": 1536, "data": "39 30 00 00 00 00 00 00", "how": "F001: 0x3039 = 12345 x 0.001 = 12.345. F01: 0 x 0.1 - 40 = -40.",
    "expect": { "F001": { "raw": "12345", "physical": "12.345" }, "F01": { "raw": "0", "physical": "-40" }, "F1M5": { "raw": "0", "physical": "0" }, "F39": { "raw": "0", "physical": "0" } } },
  { "file": "08-exact-decimals.dbc", "id": 1536, "data": "FF FF FF FF FF FF 00 00", "how": "F001 = 65535 x 0.001 = 65.535. F01 = 255 x 0.1 - 40 = -14.5. F1M5 = 65535 x 1e-05 = 0.65535. F39 = 255 x 0.00390625 = 0.99609375.",
    "expect": { "F001": { "physical": "65.535" }, "F01": { "physical": "-14.5" }, "F1M5": { "physical": "0.65535" }, "F39": { "physical": "0.99609375" } } },
  { "file": "08-exact-decimals.dbc", "id": 1536, "data": "01 00 0A D2 04 03 00 00", "how": "F001 = 0.001. F01 = 10 x 0.1 - 40 = -39. F1M5 = 0x04D2 = 1234 x 1e-05 = 0.01234. F39 = 3 x 0.00390625 = 0.01171875.",
    "expect": { "F001": { "physical": "0.001" }, "F01": { "raw": "10", "physical": "-39" }, "F1M5": { "raw": "1234", "physical": "0.01234" }, "F39": { "raw": "3", "physical": "0.01171875" } } },
  { "file": "08-exact-decimals.dbc", "id": 1536, "data": "00 00 03 01 00 01 00 00", "how": "F01 = 3 x 0.1 - 40 = -39.7 (0.3 in binary floating point is 0.30000000000000004). F1M5 = 1e-05. F39 = 0.00390625.",
    "expect": { "F01": { "physical": "-39.7" }, "F1M5": { "physical": "0.00001" }, "F39": { "physical": "0.00390625" } } },
  { "file": "08-exact-decimals.dbc", "id": 1537, "data": "FF 00 00 00 00 00 00 00", "how": "FHUGE = 255 x 10^12 = 255000000000000. TEMP raw 0 -> -273.15. FNEG raw 0 -> -12.8.",
    "expect": { "FHUGE": { "raw": "255", "physical": "255000000000000" }, "TEMP": { "physical": "-273.15" }, "FNEG": { "physical": "-12.8" }, "FTHIRD": { "physical": "0" }, "F7": { "physical": "0" } } },
  { "file": "08-exact-decimals.dbc", "id": 1537, "data": "01 B3 6A 80 03 03 00 00", "how": "FHUGE = 10^12. TEMP = 0x6AB3 = 27315 x 0.01 - 273.15 = 0 exactly. FNEG = 128 x 0.1 - 12.8 = 0. FTHIRD = 3 x 0.3 = 0.9 (binary floating point gives 0.8999999999999999). F7 = 3 x 0.07 = 0.21.",
    "expect": { "FHUGE": { "physical": "1000000000000" }, "TEMP": { "raw": "27315", "physical": "0" }, "FNEG": { "raw": "128", "physical": "0" }, "FTHIRD": { "physical": "0.9" }, "F7": { "physical": "0.21" } } },
  { "file": "08-exact-decimals.dbc", "id": 1537, "data": "00 FF FF FF 0A 64 00 00", "how": "TEMP = 65535 x 0.01 - 273.15 = 382.2. FNEG = 255 x 0.1 - 12.8 = 12.7. FTHIRD = 10 x 0.3 = 3. F7 = 100 x 0.07 = 7.",
    "expect": { "TEMP": { "physical": "382.2" }, "FNEG": { "physical": "12.7" }, "FTHIRD": { "physical": "3" }, "F7": { "physical": "7" } } },
  { "file": "08-exact-decimals.dbc", "id": 1537, "data": "00 30 75 01 FF FF 00 00", "how": "TEMP = 0x7530 = 30000 x 0.01 - 273.15 = 26.85. FNEG = 1 x 0.1 - 12.8 = -12.7. FTHIRD = 255 x 0.3 = 76.5. F7 = 255 x 0.07 = 17.85.",
    "expect": { "TEMP": { "physical": "26.85" }, "FNEG": { "physical": "-12.7" }, "FTHIRD": { "physical": "76.5" }, "F7": { "physical": "17.85" } } }
