[
  { "file": "07-signed-values.dbc", "id": 1280, "data": "7F 00 00 00 00 00 00 00", "how": "S8 = 0x7F = 127. S12 raw 0 -> 0 x 0.5 - 10 = -10. S16 = 0.",
    "expect": { "S8": { "raw": "127", "physical": "127" }, "S12": { "raw": "0", "physical": "-10" }, "S16": { "raw": "0", "physical": "0" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "80 00 00 00 00 00 00 00", "how": "0x80 as signed 8 bits = -128.", "expect": { "S8": { "raw": "-128", "physical": "-128" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "FF 00 00 00 00 00 00 00", "how": "0xFF as signed 8 bits = -1.", "expect": { "S8": { "raw": "-1" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 FF 0F 00 00 00 00 00", "how": "S12 = byte1 0xFF + low nibble of byte2 0xF -> 0xFFF = 4095 -> signed -1; physical -1 x 0.5 - 10 = -10.5.",
