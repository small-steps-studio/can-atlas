  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 00 08 00 00 00 00 00", "how": "S12 = 0x800 = 2048 -> signed -2048; physical -2048 x 0.5 - 10 = -1034.",
    "expect": { "S12": { "raw": "-2048", "physical": "-1034" } } },
  { "file": "07-signed-values.dbc", "id": 1280, "data": "00 FF 07 00 00 00 00 00", "how": "S12 = 0x7FF = 2047; physical 1023.5 - 10 = 1013.5.",
